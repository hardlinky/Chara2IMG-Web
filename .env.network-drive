# chara2img-web Network Drive Configuration

# ─── Job Storage (for temporary and archived job data) ────────────────────────

# Temporary job results directory (1-hour TTL)
# Environment variable: JOBS_TMP_DIR
# Default: PROJECT_ROOT/tmp/jobs
# Example (network mount): /mnt/chara2img-shared/jobs/tmp
# Example (local): /data/chara2img/jobs/tmp
JOBS_TMP_DIR=/data/chara2img/jobs/tmp

# Archived job results directory (pinned images stored here permanently)
# Environment variable: JOBS_ARCHIVE_DIR
# Default: PROJECT_ROOT/archive/jobs
# Example (network mount): /mnt/chara2img-shared/jobs/archive
# Example (local): /data/chara2img/jobs/archive
JOBS_ARCHIVE_DIR=/data/chara2img/jobs/archive

# Maximum storage capacity for archived (pinned) images in bytes
# When this limit is reached, oldest unpinned images are purged automatically
# Default: 0 (unlimited)
# Examples:
#   50GB = 53687091200
#   100GB = 107374182400
#   500GB = 536870912000
PINNED_IMAGES_STORAGE_CAPACITY_BYTES=107374182400

# ─── RunPod API Configuration ────────────────────────────────────────────────

# Your RunPod API Key
# Get from: https://www.runpod.io/console/api-keys
# Format: rpa_xxxxxxxxxxxx
SERVER_RUNPOD_API_KEY=rpa_xxxxxxxxxxxx

# RunPod Serverless Endpoint ID
# Get from: https://www.runpod.io/console/serverless → Endpoints
# Format: xxxxxxxxxxxxx
RUNPOD_ENDPOINT_ID=xxxxxxxxxxxxx

# Optional: Use a different RunPod API key for the endpoint
# (usually same as SERVER_RUNPOD_API_KEY unless using account delegation)
# RUNPOD_ENDPOINT_API_KEY=rpa_xxxxxxxxxxxx

# ─── Server Configuration ────────────────────────────────────────────────────

# Server port
PORT=3000

# Node environment (development, production)
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────────────────────

# Secret for signing cookies
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=your-secret-here-change-in-production

# Secret for invite-based access
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_SECRET=your-invite-secret-here-change-in-production

# Admin access passkey (can be numeric or alphanumeric)
ADMIN_ACCESS_KEY=admin123

# Allow CORS requests from different origin
# Leave empty for same-origin only (recommended for production)
# ALLOWED_ORIGIN=http://example.com:3001

# ─── Advanced Job Tracking ────────────────────────────────────────────────────

# Polling interval for RunPod job status updates (in milliseconds)
# Default: 10000 (10 seconds) - speeds up job status visibility
# Lower values = more frequent polling (uses more API calls)
# RUNPOD_TRACKER_POLL_INTERVAL_MS=10000

# ─── Optional Flags ──────────────────────────────────────────────────────────

# Allow users to self-update the application
# ALLOW_SELF_UPDATE=true

# Enable server-side RunPod key fallback
# If enabled and no client key provided, server uses SERVER_RUNPOD_API_KEY
# Has security implications - only enable if needed
# SERVER_RUNPOD_FALLBACK_ENABLED=false
