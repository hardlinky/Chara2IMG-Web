{
  "name": "chara2img-web",
  "version": "1.7.25",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx watch src/server/index.ts",
    "dev:client": "vite build --watch",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build && tsc --noEmit",
    "postinstall": "node scripts/setup-git-hooks.mjs",
    "start": "node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "dexie": "^4.4.2",
    "fake-indexeddb": "^6.2.5",
    "hono": "^4.12.0",
    "photoswipe": "^5.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-photoswipe-gallery": "^4.0.0",
    "yazl": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
